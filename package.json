{
  "name": "autoapply",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension that fills job applications from a local profile. Reviews before you submit; never submits for you.",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && npm run build:pages && npm run build:content && npm run check:manifest",
    "build:release": "npm run typecheck && vite build --mode release && vite build --config vite.content.config.ts --mode release && npm run check:manifest",
    "package": "npm run build:release && node scripts/package.mjs",
    "icons": "node scripts/make-icons.mjs",
    "store:assets": "node scripts/make-store-assets.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "build:pages": "vite build",
    "build:content": "vite build --config vite.content.config.ts",
    "dev": "npm run build && npm run watch",
    "watch": "concurrently -n pages,content \"vite build --watch\" \"vite build --config vite.content.config.ts --watch\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "serve fixtures -l 4321",
    "drive": "node scripts/drive.mjs",
    "play": "node scripts/drive.mjs --keep-open",
    "screenshots": "node scripts/drive.mjs --store",
    "drive:setup": "npx @puppeteer/browsers install chrome@stable"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "jsdom": "^25.0.1",
    "serve": "^14.2.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
